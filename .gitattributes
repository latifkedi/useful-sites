# Generated and source text files are stored LF, so a Windows build and the
# Linux CI build produce byte-identical output. Without this, autocrlf=false
# lets a Windows build commit CRLF and the "committed output matches a fresh
# build" check fails on links.js.
*.js    text eol=lf
*.mjs   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets are never line-ending converted.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.gif   binary
*.pdf   binary
