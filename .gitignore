# durum dosyasi da istisna, yoksa depoyu klonlayan (ve CI) yeniden derleyemez.
data/*.json
!data/verified.json
!data/health.json
!data/manual.json
data/worklist.txt
data/missing.txt
__pycache__/
*.pyc
